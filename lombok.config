# Đừng tìm config ở thư mục bên ngoài nữa, chỉ dùng config trong project này thôi
config.stopBubbling = true

# Copy annotation @Storage từ field sang constructor parameter
# Áp dụng cho @RequiredArgsConstructor, @AllArgsConstructor
lombok.copyableAnnotations += com.crypto.portfolio.annotation.Storage